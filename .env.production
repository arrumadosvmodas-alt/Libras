# Production Environment Variables
# Use these in Vercel and Railway dashboards

# Database (Neon)
DATABASE_URL=postgresql://[user]:[password]@[host]:5432/[database]

# Backend Server
DEBUG=False
SECRET_KEY=your-very-secure-random-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["https://libras.vercel.app", "https://yourdomain.com"]

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Stripe (optional - for payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...

# AWS S3 (optional - for video storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=libras-videos
AWS_REGION=us-east-1
